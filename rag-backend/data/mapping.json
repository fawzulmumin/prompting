{
  "settings": {
    "number_of_shards": 3,
    "number_of_replicas": 1,
    "refresh_interval": "30s",
    "analysis": {
      "normalizer": {
        "lowercase_normalizer": {
          "type": "custom",
          "filter": [
            "lowercase"
          ]
        }
      },
      "analyzer": {
        "indonesian_text": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "asciifolding"
          ]
        },
        "edge_ngram_analyzer": {
          "type": "custom",
          "tokenizer": "edge_ngram_tokenizer",
          "filter": [
            "lowercase"
          ]
        }
      },
      "tokenizer": {
        "edge_ngram_tokenizer": {
          "type": "edge_ngram",
          "min_gram": 2,
          "max_gram": 20,
          "token_chars": [
            "letter",
            "digit"
          ]
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "sekolah_id": {
        "type": "keyword",
        "index": false,
        "doc_values": false
      },
      "npsn": {
        "type": "keyword"
      },
      "nama": {
        "type": "text",
        "analyzer": "indonesian_text",
        "fields": {
          "keyword": {
            "type": "keyword",
            "normalizer": "lowercase_normalizer",
            "ignore_above": 256
          },
          "autocomplete": {
            "type": "text",
            "analyzer": "edge_ngram_analyzer",
            "search_analyzer": "indonesian_text"
          }
        }
      },
      "bentuk_pendidikan": {
        "type": "keyword",
        "eager_global_ordinals": true
      },
      "status_sekolah": {
        "type": "keyword",
        "eager_global_ordinals": true
      },
      "keaktifan": {
        "type": "keyword"
      },
      "alamat_jalan": {
        "type": "text",
        "analyzer": "indonesian_text",
        "index_options": "docs"
      },
      "desa_kelurahan": {
        "type": "keyword",
        "normalizer": "lowercase_normalizer",
        "eager_global_ordinals": true,
        "fields": {
          "text": {
            "type": "text",
            "analyzer": "indonesian_text"
          }
        }
      },
      "kecamatan": {
        "type": "keyword",
        "normalizer": "lowercase_normalizer",
        "eager_global_ordinals": true,
        "fields": {
          "text": {
            "type": "text",
            "analyzer": "indonesian_text"
          }
        }
      },
      "kabupaten": {
        "type": "keyword",
        "normalizer": "lowercase_normalizer",
        "eager_global_ordinals": true,
        "fields": {
          "text": {
            "type": "text",
            "analyzer": "indonesian_text"
          }
        }
      },
      "provinsi": {
        "type": "keyword",
        "normalizer": "lowercase_normalizer",
        "eager_global_ordinals": true,
        "fields": {
          "text": {
            "type": "text",
            "analyzer": "indonesian_text"
          }
        }
      },
      "kode_wilayah": {
        "type": "keyword",
        "index": false,
        "doc_values": false
      },
      "kode_pos": {
        "type": "keyword",
        "index": false,
        "doc_values": false
      },
      "wilayah_key": {
        "type": "keyword"
      },
      "lintang": {
        "type": "float",
        "index": false
      },
      "bujur": {
        "type": "float",
        "index": false
      },
      "lokasi": {
        "type": "geo_point"
      },
      "nomor_telepon": {
        "type": "keyword"
      },
      "email": {
        "type": "keyword"
      },
      "website": {
        "type": "keyword",
        "index": false,
        "doc_values": false
      },
      "status_kepemilikan": {
        "type": "keyword"
      },
      "yayasan": {
        "type": "text",
        "analyzer": "indonesian_text",
        "fields": {
          "keyword": {
            "type": "keyword",
            "normalizer": "lowercase_normalizer",
            "ignore_above": 256
          }
        }
      },
      "akreditasi": {
        "type": "keyword",
        "eager_global_ordinals": true
      },
      "sk_pendirian_sekolah": {
        "type": "keyword",
        "index": false,
        "doc_values": false
      },
      "tanggal_sk_pendirian": {
        "type": "date",
          "format": "yyyy-MM-dd||yyyy-MM-dd HH:mm:ss||yyyy-MM-dd HH.mm.ss.SSS||yyyy-MM-dd'T'HH:mm:ss.SSS'Z'||epoch_millis"
      },
      "sk_izin_operasional": {
        "type": "keyword",
        "index": false,
        "doc_values": false
      },
      "tanggal_sk_izin_operasional": {
        "type": "date",
        "format": "yyyy-MM-dd||yyyy-MM-dd HH:mm:ss||yyyy-MM-dd HH.mm.ss.SSS||yyyy-MM-dd'T'HH:mm:ss.SSS'Z'||epoch_millis"
      },
      "sumber_listrik": {
        "type": "keyword"
      },
      "akses_internet": {
        "type": "keyword"
      },
      "waktu_penyelenggaraan": {
        "type": "keyword"
      },
      "sertifikasi_iso": {
        "type": "keyword"
      },
      "wilayah_terpencil": {
        "type": "boolean"
      },
      "wilayah_perbatasan": {
        "type": "boolean"
      },
      "partisipasi_bos": {
        "type": "boolean"
      },
      "qc": {
        "type": "object",
        "properties": {
          "qc_1": {
            "type": "byte"
          },
          "qc_2": {
            "type": "byte"
          },
          "qc_3": {
            "type": "byte"
          },
          "qc_4": {
            "type": "byte"
          },
          "qc_5": {
            "type": "byte"
          },
          "qc_6": {
            "type": "byte"
          },
          "qc_7": {
            "type": "byte"
          },
          "qc_8": {
            "type": "byte"
          },
          "qc_9": {
            "type": "byte"
          },
          "qc_10": {
            "type": "byte"
          },
          "qc_11": {
            "type": "byte"
          },
          "qc_12": {
            "type": "byte"
          },
          "qc_13": {
            "type": "byte"
          },
          "qc_14": {
            "type": "byte"
          },
          "qc_15": {
            "type": "byte"
          }
        }
      },
      "qc_score": {
        "type": "object",
        "properties": {
          "total_masalah": {
            "type": "integer"
          },
          "persen_bersih": {
            "type": "float"
          }
        }
      },
      "content": {
        "type": "text",
        "analyzer": "indonesian_text"
      },
      "content_vector": {
        "type": "dense_vector",
        "dims": 384,
        "index": true,
        "similarity": "cosine",
        "index_options": {
          "type": "int8_hnsw",
          "m": 16,
          "ef_construction": 100
        }
      }
    }
  }
}