# Server Configuration
PORT=
PROD=

# Elasticsearch
ELASTICSEARCH_NODE=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX=
ELASTICSEARCH_ANALYTICS_INDEX=

# Redis
REDIS_URL=

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://your-frontend-domain.com

# Rate Limit — Backend (per user_id, via Redis)
# RATE_LIMIT_REQUESTS default=5  → max 5 req per window per user_id
# RATE_LIMIT_WINDOW   default=60 → window 60 detik
# RATE_LIMIT_FAIL_OPEN default=true → jika Redis mati, izinkan semua request (fail open)
#
# Catatan arsitektur — dua layer rate limit dengan dimensi berbeda:
#   Layer 1: rag-middleware (server.js) — 30 req/menit per IP (Express rate-limit)
#   Layer 2: rag-backend (di sini)     — 5 req/60s per user_id (Redis INCR)
# Keduanya AKTIF secara bersamaan. Tidak double-limit karena beda dimensi (IP vs user_id).
# Layer 1 melindungi dari flood per IP; Layer 2 melindungi per akun user.
# Untuk konsistensi, sesuaikan RATE_LIMIT_REQUESTS dengan nilai max di server.js jika diubah.
RATE_LIMIT_REQUESTS=
RATE_LIMIT_WINDOW=
RATE_LIMIT_FAIL_OPEN=

# Search
MIN_FUZZY_SCORE=

# Features
NARRATOR_ENABLED=
LOG_PROFILE_DEBUG=
EMBEDDING_ENABLED=

# AI Provider
DEEPSEEK_API_KEY=

# HuggingFace
HF_TOKEN=
HF_HUB_DISABLE_PROGRESS_BARS=
HF_HUB_DISABLE_SYMLINKS_WARNING=

# Model Cache
TRANSFORMERS_CACHE=

# Security
REPORT_API_KEY=your-secret-report-key-here